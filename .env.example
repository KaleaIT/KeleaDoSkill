# Node 24. Copy to .env.local; never commit actual secrets.
DATABASE_PATH=./data/kaleadoskill.sqlite
# Required to enable /admin. Generate a long random password and session secret.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Server-only Telegram delivery; verify the recipient and lawful data handling first.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only after the actual policy and consent documents are supplied and reviewed.
LEADS_ENABLED=false
# Enable only behind an HTTPS reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Production public origin, also used for canonical/OG/sitemap.
SITE_URL=
