# Replace school.example with the real domain. Set up a valid TLS certificate first.
# Node is bound to 127.0.0.1:3000; never expose it directly to the Internet.
server {
    listen 443 ssl;
    server_name school.example;
    ssl_certificate /etc/letsencrypt/live/school.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/school.example/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 128k;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # Overwrite, rather than append to, an arbitrary client-supplied header.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
    }
}
server {
    listen 80;
    server_name school.example;
    return 301 https://school.example$request_uri;
}
